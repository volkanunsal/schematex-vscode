{
  "name": "schematex-vscode",
  "displayName": "SchemaTex Diagrams",
  "description": "Render SchemaTex diagrams inline in the VS Code Markdown preview",
  "version": "0.5.0",
  "publisher": "VolkanUnsal",
  "license": "AGPL-3.0-only",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/volkanunsal/schematex-vscode"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/previewScript.js"
    ],
    "markdown.previewStyles": [
      "./media/previewStyles.css"
    ],
    "languages": [
      {
        "id": "schematex",
        "aliases": [
          "SchemaTex"
        ],
        "extensions": [
          ".stx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "schematex",
        "scopeName": "source.schematex",
        "path": "./syntaxes/schematex.tmLanguage.json"
      },
      {
        "scopeName": "markdown.schematex.codeblock",
        "path": "./syntaxes/schematex.markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.schematex": "schematex"
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "compile": "pnpm run typecheck && pnpm run build",
    "test": "node --test --import tsx test/*.test.ts",
    "vscode:prepublish": "pnpm run compile"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "schematex": "^1.0.14"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
